# ─────────────────────────────────────────────────────────────
# LOCAL SAFETY (optional — put in `.env.local`)
# When true: skips real email + FCM push. Still creates in-app bell rows.
# Use with a LOCAL database so test orders do not hit production.
# See `.env.local.example`
# ─────────────────────────────────────────────────────────────
# DISABLE_OUTBOUND_NOTIFICATIONS=true

# ─────────────────────────────────────────────────────────────
# TURSO DATABASE (LibSQL via Prisma)
# Get these from https://turso.tech/app
# ─────────────────────────────────────────────────────────────
TURSO_DATABASE_URL="libsql://your-db.aws-ap-south-1.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# Prisma reads DATABASE_URL — set to the same libsql URL
DATABASE_URL="libsql://your-db.aws-ap-south-1.turso.io"

# ─────────────────────────────────────────────────────────────
# FIREBASE — FCM push only (admin APK). Not used as database.
# Paste service-account JSON (private_key + client_email), not google-services.json.
# Or upload the same JSON in Admin → Settings → Push notifications.
# ─────────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_JSON=""
FIREBASE_SERVICE_ACCOUNT_FILE=".firebase-service-account.json"

# ─────────────────────────────────────────────────────────────
# AUTH (NextAuth / Auth.js v5)
# Generate a secret with: openssl rand -base64 32
# ─────────────────────────────────────────────────────────────
AUTH_SECRET="replace-with-a-strong-random-secret"
NEXTAUTH_SECRET="replace-with-a-strong-random-secret"
AUTH_TRUST_HOST=true
NEXTAUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────
# CRON (Vercel — auto-mark dispatched orders as delivered)
# Generate with: openssl rand -base64 32
# ─────────────────────────────────────────────────────────────
CRON_SECRET="replace-with-a-strong-random-secret"

# ─────────────────────────────────────────────────────────────
# EMAIL (optional — defaults can be set in Admin → Settings)
# ─────────────────────────────────────────────────────────────
EMAIL_SMTP_HOST="smtp.hostinger.com"
EMAIL_SMTP_PORT="465"
EMAIL_SMTP_USERNAME="admin@srkcrackers.in"
EMAIL_SMTP_PASSWORD=""
EMAIL_ADMIN_NOTIFY="admin@srkcrackers.in"

# ─────────────────────────────────────────────────────────────
# BUG REPORTS (ntfy.sh push to developer phone)
# Default topic: udyilangovan — https://ntfy.sh/udyilangovan
# ─────────────────────────────────────────────────────────────
NTFY_TOPIC="udyilangovan"

# ─────────────────────────────────────────────────────────────
# ADMIN LOGIN (used by npm run db:seed on a fresh empty database)
# ─────────────────────────────────────────────────────────────
ADMIN_EMAIL="admin@srkcrackers.com"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="SRK Admin"
