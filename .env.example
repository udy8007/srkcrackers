# ─────────────────────────────────────────────────────────────
# DATABASE (Neon Postgres)
# DATABASE_URL  -> pooled connection (used by the app at runtime)
# DIRECT_URL    -> direct/unpooled connection (used by Prisma Migrate)
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# ─────────────────────────────────────────────────────────────
# AUTH (NextAuth / Auth.js v5)
# Generate a secret with: openssl rand -base64 32
# ─────────────────────────────────────────────────────────────
AUTH_SECRET="replace-with-a-strong-random-secret"
NEXTAUTH_SECRET="replace-with-a-strong-random-secret"
AUTH_TRUST_HOST=true
NEXTAUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────
# ADMIN SEED CREDENTIALS (used by `npm run db:seed`)
# ─────────────────────────────────────────────────────────────
ADMIN_EMAIL="admin@srkcrackers.com"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="SRK Admin"
