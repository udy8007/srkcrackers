# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` on the server (cPanel env editor) or `.env.local` locally.
# Never commit real credentials.
# ─────────────────────────────────────────────────────────────

# LOCAL SAFETY (optional — `.env.local` only)
# When true: skips real email + FCM push. Still creates in-app bell rows.
# DISABLE_OUTBOUND_NOTIFICATIONS=true

# ─────────────────────────────────────────────────────────────
# MYSQL DATABASE (Prisma)
# ─────────────────────────────────────────────────────────────
# URL-encode special characters in the password (e.g. & → %26, ! → %21).
# From this app on the same Hostinger account, localhost often works:
#   mysql://USER:PASSWORD@localhost:3306/DATABASE
# From another machine, use the remote MySQL hostname after allowing your IP
# in cPanel → Remote MySQL:
#   mysql://USER:PASSWORD@cloud-xent.crazzydns.com:3306/DATABASE
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DATABASE"

# ─────────────────────────────────────────────────────────────
# FIREBASE — FCM push only (admin APK). Not used as database.
# Paste service-account JSON, or upload it in Admin → Settings.
# ─────────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_JSON=""
FIREBASE_SERVICE_ACCOUNT_FILE=".firebase-service-account.json"
# GOOGLE_APPLICATION_CREDENTIALS=".firebase-service-account.json"

# ─────────────────────────────────────────────────────────────
# AUTH (NextAuth / Auth.js v5)
# Generate: openssl rand -base64 32
# ─────────────────────────────────────────────────────────────
AUTH_SECRET="replace-with-a-strong-random-secret"
NEXTAUTH_SECRET="replace-with-a-strong-random-secret"
AUTH_TRUST_HOST=true
# No AUTH_URL / NEXTAUTH_URL needed — the site origin is detected
# dynamically from each request (host + x-forwarded-proto headers).

# ─────────────────────────────────────────────────────────────
# CRON (vercel.json crons do not run on cPanel — use cPanel Cron Jobs)
# Generate: openssl rand -base64 32
# Every 30 minutes:
# curl -fsS -H "Authorization: Bearer YOUR_CRON_SECRET" https://srkcrackers.in/api/cron/notifications
# ─────────────────────────────────────────────────────────────
CRON_SECRET="replace-with-a-strong-random-secret"

# ─────────────────────────────────────────────────────────────
# CPANEL NODE.JS APP (GitHub → /home/srkcrack/repositories/srkcrackers)
# Application root: repositories/srkcrackers
# Application URL: srkcrackers.in
# Startup file: server.js
# Application mode: Production
# Node.js: 24.19.0
# Remove any old Node.js app whose root was `api` and URL was /api
# (APIs are Next.js App Router routes in this same process.)
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# EMAIL (optional — SMTP can also be set in Admin → Settings)
# ─────────────────────────────────────────────────────────────
EMAIL_SMTP_HOST="smtp.example.com"
EMAIL_SMTP_PORT="465"
EMAIL_SMTP_USERNAME="admin@example.com"
EMAIL_SMTP_PASSWORD=""
EMAIL_ADMIN_NOTIFY="admin@example.com"

# ─────────────────────────────────────────────────────────────
# RAZORPAY (online payments)
# Dashboard → Settings → API Keys. Webhook URL:
#   https://www.srkcrackers.in/api/payments/razorpay/webhook
# Events: payment.captured, payment.failed, order.paid
# ─────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ─────────────────────────────────────────────────────────────
# BUG REPORTS (ntfy.sh)
# ─────────────────────────────────────────────────────────────
NTFY_TOPIC="your-ntfy-topic"

# ─────────────────────────────────────────────────────────────
# ADMIN LOGIN (used by npm run db:seed on a fresh empty database)
# ─────────────────────────────────────────────────────────────
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="SRK Admin"
