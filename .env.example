# ─────────────────────────────────────────────────────────────
# FIREBASE (primary database — Firestore + Storage + FCM)
# Project: srk-cracker
# Paste the full service-account JSON as a single-line string.
# Firebase Console → Project settings → Service accounts → Generate new private key.
# Also enable Firestore and Storage in the Firebase console.
# Optional: FIREBASE_STORAGE_BUCKET=srk-cracker.appspot.com
# Do NOT use google-services.json here (APK only).
# ─────────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_JSON=""
FIREBASE_SERVICE_ACCOUNT_FILE=".firebase-service-account.json"
FIREBASE_STORAGE_BUCKET="srk-cracker.firebasestorage.app"

# ─────────────────────────────────────────────────────────────
# AUTH (NextAuth / Auth.js v5)
# Generate a secret with: openssl rand -base64 32
# ─────────────────────────────────────────────────────────────
AUTH_SECRET="replace-with-a-strong-random-secret"
NEXTAUTH_SECRET="replace-with-a-strong-random-secret"
AUTH_TRUST_HOST=true
NEXTAUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────
# CRON (Vercel — auto-mark dispatched orders as delivered)
# Generate with: openssl rand -base64 32
# Set the same value in Vercel project env + Cron auth if required
# ─────────────────────────────────────────────────────────────
CRON_SECRET="replace-with-a-strong-random-secret"

# ─────────────────────────────────────────────────────────────
# EMAIL (optional — defaults can be set in Admin → Settings)
# SMTP password is stored in DB after first admin save; env is fallback for seed only
# ─────────────────────────────────────────────────────────────
EMAIL_SMTP_HOST="smtp.hostinger.com"
EMAIL_SMTP_PORT="465"
EMAIL_SMTP_USERNAME="admin@srkcrackers.in"
EMAIL_SMTP_PASSWORD=""
EMAIL_ADMIN_NOTIFY="admin@srkcrackers.in"

# ─────────────────────────────────────────────────────────────
# ADMIN LOGIN (used by npm run db:import-firebase to seed adminUsers)
# ─────────────────────────────────────────────────────────────
ADMIN_EMAIL="admin@srkcrackers.com"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="SRK Admin"

