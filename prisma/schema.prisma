// SRK Crackers — Prisma schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrderStatus {
  PAYMENT_PENDING
  PLACED
  PAYMENT_UPLOADED
  VERIFYING
  CONFIRMED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum UserRole {
  ADMIN
  STAFF
}

enum BackupFrequency {
  DAILY
  MONTHLY
  YEARLY
}

/// Admin/staff accounts for the dashboard (credentials login).
model AdminUser {
  id           String             @id @default(cuid())
  email        String             @unique
  name         String?
  passwordHash String
  role         UserRole           @default(ADMIN)
  deviceTokens AdminDeviceToken[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

/// Product categories (One Sound, Flower Pots, Rockets, ...).
model Category {
  id        String    @id @default(cuid())
  key       String    @unique
  label     String
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Individual crackers products.
model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  pack        String
  price       Int // discounted sale price (INR, whole rupees)
  mrp         Int // maximum retail price (INR, whole rupees)
  imageUrl    String
  description String
  active      Boolean     @default(true)
  sortOrder   Int         @default(0)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([categoryId])
}

/// A customer order (enquiry) placed from the storefront.
model Order {
  id                String               @id @default(cuid())
  orderNumber       String               @unique // SRK-YYYYMMDD-XXXX
  // Customer details
  customerName      String
  phone             String
  altPhone          String?
  email             String?
  address           String
  city              String
  state             String
  pincode           String
  notes             String?
  // Payment
  paymentMethod     String               @default("UPI")
  upiId             String?
  paymentScreenshot String? // base64 data URL — swap for object storage (Vercel Blob / Cloudinary) in production
  // Totals
  subtotal          Int
  total             Int
  status            OrderStatus          @default(VERIFYING)
  expectedDeliveryAt DateTime?           // set when marked dispatched — auto DELIVERED after this time
  lastPendingReminderAt DateTime?       // last admin reminder for unactioned orders
  items             OrderItem[]
  statusHistory     OrderStatusHistory[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([phone])
  @@index([status])
  @@index([createdAt])
}

/// Line items of an order (product snapshot kept for historical accuracy).
model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  pack      String
  price     Int
  qty       Int
  amount    Int

  @@index([orderId])
}

/// Storefront page visits for admin analytics (city + time).
model SiteVisit {
  id        String   @id @default(cuid())
  path      String   @default("/")
  city      String?
  region    String?
  country   String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([city])
}

/// Timeline of status changes for an order.
model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  label     String
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

/// Singleton SMTP + notification configuration (admin portal).
model EmailSettings {
  id                       String   @id @default("default")
  enabled                  Boolean  @default(false)
  host                     String   @default("")
  port                     Int      @default(465)
  enableSsl                Boolean  @default(true)
  username                 String   @default("")
  password                 String   @default("")
  fromEmail                String   @default("")
  fromName                 String   @default("SRK Crackers")
  adminNotifyEmail         String   @default("")
  notifyCustomerOrderPlaced  Boolean @default(true)
  notifyCustomerStatusChange Boolean @default(true)
  notifyCustomerDelivered    Boolean @default(true)
  notifyAdminNewOrder        Boolean @default(true)
  notifyAdminStatusChange    Boolean @default(false)
  notifyAdminPendingReminder Boolean @default(true)
  pendingReminderHours       Int     @default(2)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

/// Audit log of outbound emails.
model EmailLog {
  id        String   @id @default(cuid())
  orderId   String?
  trigger   String
  recipient String
  subject   String
  status    String
  error     String?
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([createdAt])
  @@index([trigger])
}

/// In-app admin notification alerts.
model AdminNotification {
  id          String   @id @default(cuid())
  type        String
  title       String
  message     String
  orderId     String?
  orderNumber String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([read, createdAt])
}

/// Singleton database backup schedule (admin portal).
model BackupSettings {
  id                 String          @id @default("default")
  enabled            Boolean         @default(false)
  frequency          BackupFrequency @default(DAILY)
  recipientEmail     String          @default("")
  runHour            Int             @default(2)
  runDayOfMonth      Int             @default(1)
  runMonth           Int             @default(1)
  runDayOfYear       Int             @default(1)
  includeScreenshots Boolean         @default(false)
  lastBackupAt       DateTime?
  lastBackupStatus   String?
  lastBackupError    String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

/// History of database backup runs.
model DbBackupLog {
  id          String   @id @default(cuid())
  filename    String
  sizeBytes   Int
  tableCounts String?
  status      String
  trigger     String
  recipient   String
  error       String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

/// In-app scheduler state (DB-backed — runs reminders/backup without Vercel Pro cron).
model SchedulerState {
  id                  String    @id @default("default")
  enabled             Boolean   @default(true)
  tickIntervalMinutes Int       @default(30)
  lastTickAt          DateTime?
  lastDeliverAt       DateTime?
  lastReminderAt      DateTime?
  updatedAt           DateTime  @updatedAt
}

/// FCM device tokens for the admin WebView APK (push on new orders, etc.).
model AdminDeviceToken {
  id          String     @id @default(cuid())
  token       String     @unique
  platform    String     @default("android")
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([adminUserId])
}

/// Firebase service account for server-side FCM (uploaded in Admin → Settings).
model FirebaseSettings {
  id                 String   @id @default("default")
  serviceAccountJson String   @default("")
  projectId          String   @default("")
  clientEmail        String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
