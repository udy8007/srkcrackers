// SRK Crackers — Prisma schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PAYMENT_PENDING
  PLACED
  PAYMENT_UPLOADED
  VERIFYING
  CONFIRMED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum UserRole {
  ADMIN
  STAFF
}

enum BackupFrequency {
  DAILY
  MONTHLY
  YEARLY
}

enum ReportEmailFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum ArchiveFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum EnquiryStatus {
  PENDING
  RESOLVED
}

/// Admin/staff accounts for the dashboard (credentials login).
model AdminUser {
  id           String             @id @default(cuid())
  email        String             @unique
  name         String?
  passwordHash String
  role         UserRole           @default(ADMIN)
  deviceTokens AdminDeviceToken[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

/// Product categories (One Sound, Flower Pots, Rockets, ...).
model Category {
  id        String    @id @default(cuid())
  key       String    @unique
  label     String
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Individual crackers products.
model Product {
  id          String          @id @default(cuid())
  name        String
  nameTa      String? // Tamil product name (optional)
  slug        String          @unique
  pack        String
  price       Int // discounted sale price (INR, whole rupees)
  mrp         Int // maximum retail price (INR, whole rupees)
  imageUrl    String
  description String
  active      Boolean         @default(true)
  sortOrder   Int             @default(0)
  categoryId  String
  category    Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  reviews     ProductReview[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([categoryId])
}

/// A customer order (enquiry) placed from the storefront.
model Order {
  id                String               @id @default(cuid())
  orderNumber       String               @unique // SRK-YYYYMMDD-XXXX
  // Customer details
  customerName      String
  phone             String
  altPhone          String?
  email             String?
  address           String
  city              String
  state             String
  pincode           String
  notes             String?
  // Payment
  paymentMethod       String               @default("UPI")
  upiId               String?
  upiReferenceNumber  String? // customer UPI / UTR reference from payment app
  paymentScreenshot   String? // base64 data URL — swap for object storage (Vercel Blob / Cloudinary) in production
  // Totals
  subtotal          Int
  total             Int
  status            OrderStatus          @default(VERIFYING)
  expectedDeliveryAt DateTime?           // set when marked dispatched — auto DELIVERED after this time
  lastPendingReminderAt DateTime?       // last admin reminder for unactioned orders
  items             OrderItem[]
  statusHistory     OrderStatusHistory[]
  reviews           ProductReview[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([phone])
  @@index([status])
  @@index([createdAt])
}

/// Line items of an order (product snapshot kept for historical accuracy).
model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  pack      String
  price     Int
  qty       Int
  amount    Int
  review    ProductReview?

  @@index([orderId])
}

/// Verified-purchase product reviews (one per order line item).
model ProductReview {
  id           String    @id @default(cuid())
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId      String
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId  String    @unique
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  rating       Int
  text         String
  reviewerName String
  visible      Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([productId, visible, createdAt])
  @@index([orderId])
  @@index([visible, createdAt])
}

/// General contact enquiry submitted from the storefront (not an order).
model Enquiry {
  id                    String        @id @default(cuid())
  enquiryNumber         String        @unique // ENQ-YYYYMMDD-XXXX
  name                  String
  phone                 String
  email                 String?
  message               String
  status                EnquiryStatus @default(PENDING)
  adminNote             String?
  lastPendingReminderAt DateTime?
  resolvedAt            DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([phone])
  @@index([status])
  @@index([createdAt])
}

/// Storefront page visits for admin analytics (city + time).
model SiteVisit {
  id        String   @id @default(cuid())
  path      String   @default("/")
  city      String?
  region    String?
  country   String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([city])
}

/// Timeline of status changes for an order.
model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  label     String
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

/// Singleton SMTP + notification configuration (admin portal).
model EmailSettings {
  id                       String   @id @default("default")
  enabled                  Boolean  @default(false)
  host                     String   @default("")
  port                     Int      @default(465)
  enableSsl                Boolean  @default(true)
  username                 String   @default("")
  password                 String   @default("")
  fromEmail                String   @default("")
  fromName                 String   @default("SRK Crackers")
  adminNotifyEmail         String   @default("")
  notifyCustomerOrderPlaced  Boolean @default(true)
  notifyCustomerStatusChange Boolean @default(true)
  notifyCustomerDelivered    Boolean @default(true)
  notifyAdminNewOrder        Boolean @default(true)
  notifyAdminStatusChange    Boolean @default(false)
  notifyAdminPendingReminder Boolean @default(true)
  pendingReminderHours       Int     @default(2)
  notifyAdminNewEnquiry        Boolean @default(true)
  notifyCustomerEnquiryResolved Boolean @default(true)
  notifyAdminEnquiryPendingReminder Boolean @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

/// Audit log of outbound emails.
model EmailLog {
  id        String   @id @default(cuid())
  orderId   String?
  trigger   String
  recipient String
  subject   String
  status    String
  error     String?
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([createdAt])
  @@index([trigger])
}

/// In-app admin notification alerts.
model AdminNotification {
  id            String   @id @default(cuid())
  type          String
  title         String
  message       String
  orderId       String?
  orderNumber   String?
  enquiryId     String?
  enquiryNumber String?
  read          Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([read, createdAt])
}

/// Audit log of outbound admin FCM push attempts.
model AdminPushLog {
  id            String   @id @default(cuid())
  type          String
  title         String
  body          String
  targetUrl     String
  orderId       String?
  orderNumber   String?
  enquiryId     String?
  enquiryNumber String?
  status        String
  sent          Int      @default(0)
  failed        Int      @default(0)
  removed       Int      @default(0)
  error         String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([orderId])
  @@index([enquiryId])
  @@index([type])
  @@index([status])
}

/// Singleton database backup schedule (admin portal).
model BackupSettings {
  id                 String          @id @default("default")
  enabled            Boolean         @default(false)
  frequency          BackupFrequency @default(DAILY)
  recipientEmail     String          @default("")
  runHour            Int             @default(2)
  runDayOfMonth      Int             @default(1)
  runMonth           Int             @default(1)
  runDayOfYear       Int             @default(1)
  includeScreenshots Boolean         @default(false)
  lastBackupAt       DateTime?
  lastBackupStatus   String?
  lastBackupError    String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

/// History of database backup runs.
model DbBackupLog {
  id          String   @id @default(cuid())
  filename    String
  sizeBytes   Int
  tableCounts String?
  status      String
  trigger     String
  recipient   String
  error       String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

/// In-app scheduler state (DB-backed — runs reminders/backup without Vercel Pro cron).
model SchedulerState {
  id                  String    @id @default("default")
  enabled             Boolean   @default(true)
  tickIntervalMinutes Int       @default(30)
  lastTickAt          DateTime?
  lastDeliverAt       DateTime?
  lastReminderAt      DateTime?
  updatedAt           DateTime  @updatedAt
}

/// FCM device tokens for the admin WebView APK (push on new orders, etc.).
model AdminDeviceToken {
  id          String     @id @default(cuid())
  token       String     @unique
  platform    String     @default("android")
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([adminUserId])
}

/// Firebase service account for server-side FCM (uploaded in Admin → Settings).
model FirebaseSettings {
  id                 String   @id @default("default")
  serviceAccountJson String   @default("")
  projectId          String   @default("")
  clientEmail        String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// Admin portal activity audit (who changed what).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  actorName  String?
  action     String // e.g. PRODUCT_CREATE, ORDER_STATUS_CHANGE
  entityType String // product | order | category | settings | account | system
  entityId   String?
  summary    String // human-readable one-liner for the table
  metadata   String? // JSON string of small details
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, createdAt])
  @@index([action, createdAt])
  @@index([actorEmail, createdAt])
}

/// Scheduled email business reports to admin (Sales / Orders / Catalog / Traffic).
model ReportEmailSettings {
  id               String               @id @default("default")
  enabled          Boolean              @default(false)
  frequency        ReportEmailFrequency @default(DAILY)
  recipientEmail   String               @default("")
  runHour          Int                  @default(8) // IST hour 0–23
  runDayOfWeek     Int                  @default(1) // 0=Sun … 6=Sat (weekly)
  runDayOfMonth    Int                  @default(1)
  includeSales     Boolean              @default(true)
  includeOrders    Boolean              @default(true)
  includeCatalog   Boolean              @default(true)
  includeTraffic   Boolean              @default(true)
  notifyPush       Boolean              @default(true) // FCM + in-app bell → /admin/reports
  lastSentAt       DateTime?
  lastStatus       String?
  lastError        String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

/// Singleton data archive schedule — export old logs by email then purge.
model ArchiveSettings {
  id                     String           @id @default("default")
  enabled                Boolean          @default(false)
  emailExportEnabled       Boolean          @default(true)
  frequency              ArchiveFrequency @default(MONTHLY)
  recipientEmail         String           @default("")
  runHour                Int              @default(2)
  runDayOfWeek           Int              @default(0)
  runDayOfMonth          Int              @default(1)
  cronExpression         String           @default("0 2 1 * *")
  retentionMonths        Int              @default(2)
  includeSiteVisits      Boolean          @default(true)
  includeErrorLogs       Boolean          @default(true)
  includeAuditLogs       Boolean          @default(true)
  includeNotificationLog Boolean          @default(true)
  lastArchiveAt          DateTime?
  lastArchiveStatus      String?
  lastArchiveError       String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
}

/// History of data archive runs.
model ArchiveLog {
  id           String   @id @default(cuid())
  filename     String
  sizeBytes    Int
  recordCounts String?
  status       String
  trigger      String
  recipient    String
  error        String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}
