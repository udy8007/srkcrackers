{
  "name": "srkcrackers",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node -e \"const fs=require('node:fs');const path=require('node:path');require(path.join(path.dirname(fs.realpathSync(process.env.npm_package_json)),'scripts','npm-cpanel-entry.cjs'))\"",
    "build:cpanel": "node scripts/cpanel-pack.mjs",
    "start": "next start",
    "start:cpanel": "node server.js",
    "lint": "eslint",
    "postinstall": "node -e \"const fs=require('node:fs');const path=require('node:path');require(path.join(path.dirname(fs.realpathSync(process.env.npm_package_json)),'scripts','npm-cpanel-entry.cjs'))\"",
    "db:generate": "node -e \"process.env.SRK_NPM_TASK='generate';const fs=require('node:fs');const path=require('node:path');require(path.join(path.dirname(fs.realpathSync(process.env.npm_package_json)),'scripts','npm-cpanel-entry.cjs'))\"",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:migrate-from-turso": "tsx scripts/migrate-turso-to-mysql.ts",
    "db:dump-turso": "tsx scripts/migrate-turso-to-mysql.ts --dump-only",
    "db:sync-catalog": "tsx scripts/sync-catalog.ts",
    "db:studio": "prisma studio",
    "icons": "node scripts/generate-favicons.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bcryptjs": "^3.0.3",
    "eslint": "^9",
    "eslint-config-next": "^15.5.20",
    "firebase-admin": "^14.1.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lottie-react": "^2.4.1",
    "mysql2": "^3.24.4",
    "next": "^15.5.20",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^7.0.13",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@libsql/client": "^0.15.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.5",
    "pg": "^8.16.3",
    "tsx": "^4.23.0"
  }
}
