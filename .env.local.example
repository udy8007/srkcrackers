# ─────────────────────────────────────────────────────────────
# LOCAL TEST ONLY — copy to `.env.local` and fill values
# Next.js loads `.env.local` over `.env`.
# ─────────────────────────────────────────────────────────────

# MySQL (same Hostinger DB, or a local MySQL instance)
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/DATABASE"

AUTH_SECRET="local-dev-auth-secret-change-me"
NEXTAUTH_SECRET="local-dev-auth-secret-change-me"
AUTH_TRUST_HOST=true

# Block real email + FCM push while testing
DISABLE_OUTBOUND_NOTIFICATIONS=true

# Do not use production Firebase from local
FIREBASE_SERVICE_ACCOUNT_FILE=""
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Razorpay test keys (Dashboard → Test Mode)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Seed admin (used by npm run db:seed)
ADMIN_EMAIL="admin@srkcrackers.com"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="SRK Admin Local"
