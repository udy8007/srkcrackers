# ─────────────────────────────────────────────────────────────
# LOCAL TEST ONLY — copy to `.env.local` and fill LOCAL_PG_PASSWORD
# Next.js loads `.env.local` over `.env`, so production Supabase is ignored.
# ─────────────────────────────────────────────────────────────

# Local Postgres (you already have PostgreSQL 17 running)
# Replace PASSWORD with your Windows Postgres password for user `postgres`
DATABASE_URL="postgresql://postgres:PASSWORD@127.0.0.1:5432/srkcrackers_local?schema=public"
DIRECT_URL="postgresql://postgres:PASSWORD@127.0.0.1:5432/srkcrackers_local?schema=public"

AUTH_SECRET="local-dev-auth-secret-change-me"
NEXTAUTH_SECRET="local-dev-auth-secret-change-me"
AUTH_TRUST_HOST=true
NEXTAUTH_URL="http://localhost:3000"

# Block real email + FCM push while testing
DISABLE_OUTBOUND_NOTIFICATIONS=true

# Do not use production Firebase from local
FIREBASE_SERVICE_ACCOUNT_FILE=""
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Seed admin (used by npm run db:seed)
ADMIN_EMAIL="admin@srkcrackers.com"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="SRK Admin Local"
