# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Capacitor / Android local build artifacts
mobile-admin/node_modules/
mobile-admin/android/.gradle/
mobile-admin/android/app/build/
mobile-admin/android/build/
mobile-admin/android/app/google-services.json
mobile-admin/android/local.properties
mobile-admin/android/capacitor-cordova-android-plugins/

# Firebase client config (Android APK only — do not commit service account keys)
**/google-services.json

# Local database dumps (contain customer data)
/backups/

# Turso schema push temp files
.turso-push-temp.*
.migration-temp.db

# Firebase Admin SDK private key (never commit)
.firebase-service-account.json

